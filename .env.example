# Copie este arquivo para ".env" apenas para referência local.
# Em produção, essas variáveis são cadastradas no painel da Netlify
# (Site settings > Environment variables), NUNCA commitadas no Git.

# Segredo usado para assinar os tokens de login. Gere um valor aleatório longo, por exemplo:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Usuário 1 (você)
USER1_NAME=jobs
USER1_PASS_HASH=
USER1_ROLE=Servidor Público

# Usuário 2 (sua namorada)
USER2_NAME=
USER2_PASS_HASH=
USER2_ROLE=CLT

# Para gerar USER1_PASS_HASH / USER2_PASS_HASH, rode localmente:
# npm install
# npm run gerar-hash -- "suaSenhaAqui"
